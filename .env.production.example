# Values for docker-compose.prod.yml. Copy to .env.production (never commit that file).

# Public addresses (behind HTTPS)
PUBLIC_WEB_URL=https://clauselens.example.com
PUBLIC_API_URL=https://api.clauselens.example.com

# Database password — long and random
POSTGRES_PASSWORD=

# Uploaded files are encrypted with this key. Generate:
#   cd backend && uv run python -m scripts.new_encryption_key
# Back it up somewhere safe: without it the stored files cannot be read.
FILE_ENCRYPTION_KEY=

# Firebase project (Google sign-in). Web-app values from Firebase console → Project settings.
FIREBASE_PROJECT_ID=legal-department-f5b74
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=legal-department-f5b74.firebaseapp.com
NEXT_PUBLIC_FIREBASE_APP_ID=
# Also add the website's domain in Firebase → Authentication → Settings → Authorized domains.

# Optional
RETENTION_DAYS=0
AI_PROVIDER=none
AI_API_KEY=
WEB_WORKERS=2
