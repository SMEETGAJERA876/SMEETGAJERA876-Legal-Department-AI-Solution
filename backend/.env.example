ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://clauselens:clauselens@localhost:5433/clauselens
CORS_ORIGINS=["http://localhost:3000"]
UPLOAD_DIR=storage/uploads
MAX_UPLOAD_SIZE_MB=25

# Local embeddings for semantic search (downloaded once, ~70 MB)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_CACHE_DIR=storage/models

# Plain-language AI answers. "none" = answers quote the document directly.
# "anthropic" = Claude writes plain-language explanations (needs AI_API_KEY).
AI_PROVIDER=none
AI_API_KEY=
AI_CHAT_MODEL=claude-opus-5
AI_EFFORT=medium

# Sign-in: "firebase" = Google sign-in required (set FIREBASE_PROJECT_ID).
# "disabled" = everything runs as one local user; for local development only.
AUTH_MODE=disabled
FIREBASE_PROJECT_ID=

# Public read-only demo (docs/Demo.md): the documents loaded by `scripts.seed_demo` may be read
# and asked questions without signing in. Uploading and any change always need Google.
DEMO_MODE_ENABLED=true
# Load them in the background at start-up (for hosts with no shell to run scripts.seed_demo).
DEMO_AUTO_SEED=false

# What to do when there is strong, checkable evidence that a document is not what it claims
# to be (docs/Authenticity.md): warn (accept and say so), reject (refuse it), off.
# Never decided from writing style.
AUTHENTICITY_POLICY=warn

# Uploaded files are encrypted at rest with this key (AES-256-GCM). Required in production.
# Generate: uv run python -m scripts.new_encryption_key
FILE_ENCRYPTION_KEY=

# Security (app/core/security.py) and retention (app/services/lifecycle.py)
RATE_LIMIT_ENABLED=true
TRUST_PROXY_HEADERS=false
# Delete documents automatically this many days after upload (0 = never)
RETENTION_DAYS=0
